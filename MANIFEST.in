graft src
graft libbin
prune libbin/build
prune src/islenska/__pycache__
prune src/islenska/.mypy_cache
prune test
exclude src/islenska/_bin.cpp
exclude src/islenska/_bin.c
# The data files are in the islenska-data package; the resources directory
# holds only build inputs and, in a source checkout, the built data
prune src/islenska/resources
exclude src/islenska/.DS_Store
exclude src/islenska/*.o
exclude src/islenska/*.so
